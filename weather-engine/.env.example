# Copy to .env and fill in. Never commit .env.

# Storage locations (defaults: ./data, ./models, ./reports)
WE_DATA_DIR=./data
WE_MODELS_DIR=./models
WE_REPORTS_DIR=./reports

# Database (matches docker-compose.yml defaults)
POSTGRES_USER=weather
POSTGRES_PASSWORD=change-me
POSTGRES_DB=weather
DATABASE_URL=postgresql://weather:change-me@localhost:5432/weather

# api.weather.gov requires an identifying User-Agent, e.g. "(myapp, you@example.com)"
NWS_USER_AGENT=

LOG_LEVEL=INFO
