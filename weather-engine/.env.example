# Optional overrides (defaults shown)
# WEATHER_ENGINE_DATA=./data
# WEATHER_ENGINE_REPORTS=./reports
# NWS asks API clients to identify themselves; include contact info if you like.
# WEATHER_ENGINE_USER_AGENT="weather-engine/0.1 (personal forecasting project)"

# Synoptic Data API token: lets the engine find the nearest station on ANY network
# (flood-control gauges, RAWS, road weather, mesonets), not just airports.
# Free account at https://synopticdata.com — keep this file private (it is git-ignored).
# WEATHER_ENGINE_SYNOPTIC_TOKEN=your-token-here
