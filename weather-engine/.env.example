# Copy to .env and edit. Never commit .env. All values are optional.

# Storage (defaults: ./data, ./models, ./reports, ./data/weather.db)
WE_DATA_DIR=./data
WE_MODELS_DIR=./models
WE_REPORTS_DIR=./reports
WE_DB_PATH=./data/weather.db
WE_LOCATIONS_FILE=./locations.toml

# Open-Meteo model ids to blend (comma-separated). Check ids against
# https://open-meteo.com/en/docs before adding more (e.g. an HRRR id for the US).
WE_MODELS=ecmwf_ifs025,gfs_seamless,icon_seamless,gem_seamless

# NOAA station forecasts via Iowa Environmental Mesonet:
# GFS/NAM = MOS, NBS/NBE = National Blend of Models, LAV = GFS LAMP
WE_MOS_MODELS=GFS,NAM,NBS,NBE,LAV

# Sent to every data source. api.weather.gov asks for a way to contact you,
# e.g. "weather-engine (you@example.com)". Your choice whether to include one.
WE_USER_AGENT=weather-engine/0.1

LOG_LEVEL=INFO
