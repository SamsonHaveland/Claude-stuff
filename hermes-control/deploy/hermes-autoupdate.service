# Linux / Raspberry Pi: one-shot unit run by hermes-autoupdate.timer. NOT INSTALLED.
# Runs as the account that owns ~/.hermes (adjust User=). See docs/AUTO_UPDATE.md.
[Unit]
Description=Unattended Hermes update (stable channel)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Environment=PATH=/home/hermes/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/hermes-control/deploy/hermes-autoupdate.sh
# Gateway drain can take up to agent.restart_after_turn_timeout (30 min default).
TimeoutStartSec=90min
Nice=10
