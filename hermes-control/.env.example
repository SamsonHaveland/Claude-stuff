# Copy to .env (git-ignored) and `chmod 600 .env`. One key per Hermes profile you enable.
# Each value must equal that profile's API_SERVER_KEY in ~/.hermes/profiles/<name>/.env
# (default profile: ~/.hermes/.env). Never commit real values.
HC_HERMES_KEY_JEFF=
# HC_HERMES_KEY_HARRY=
# HC_HERMES_KEY_ROXY=
# HC_HERMES_KEY_DEBRA=
# HC_HERMES_KEY_LENA=
# HC_HERMES_KEY_SCOUT=
